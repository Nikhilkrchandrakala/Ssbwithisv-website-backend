PORT=5001
MONGO_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/ssb
JWT_SECRET=your_jwt_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_password
FAST2SMS_API_KEY=your_fast2sms_key
CLIENT_URL=http://localhost:3000
API_BASE_URL=https://api.ssbwithisv.in
MSG91_AUTHKEY=your_msg91_key
VERIFY_ACCESS_TOKEN_URL=
WEB_HEAD_EMAIL=
WEB_HEAD_PASSWORD=
EMAIL_USER=
EMAIL_PASS=
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ─── Social Login OAuth (all free) ───
# Google: https://console.cloud.google.com → APIs → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook: https://developers.facebook.com → New App → Facebook Login
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# LinkedIn: https://linkedin.com/developers → New App → Sign In with LinkedIn (OpenID Connect)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Session secret: any random string (used only for OAuth handshake sessions)
SESSION_SECRET=change_this_to_a_random_secret_string
